<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fusen" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 一覧画面: 背景の透過度を壁紙に反映できるよう透明ウィンドウ -->
    <style name="Theme.Fusen.Main" parent="Theme.Fusen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- 編集・設定画面: 透明ウィンドウ（ダイアログ風） -->
    <style name="Theme.Fusen.Transparent" parent="Theme.Fusen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
