<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#2EFFFFFF" android:endColor="#33000000" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="0dp" android:left="3dp" android:right="3dp">
        <bitmap android:src="@drawable/paper_noise" android:tileMode="repeat" />
    </item>
</layer-list>
